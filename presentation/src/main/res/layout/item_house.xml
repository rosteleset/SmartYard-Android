<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="10dp"
    android:background="@drawable/background_card"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/house_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/house_address"
            style="@style/Base.TextAppearance.AppCompat.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="64dp"
            android:gravity="center_vertical"
            android:padding="24dp"
            android:textColor="@color/accent"
            android:textSize="14sp"
            tools:text="@string/address_sample"
            tools:textSize="18sp" />

        <ImageView
            android:id="@+id/expand_house"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerInside"
            android:layout_gravity="center_vertical|end"
            app:srcCompat="@drawable/ic_expand"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <net.cachapa.expandablelayout.ExpandableLayout
        android:id="@+id/expandable_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:el_duration="300"
        app:el_expanded="false"
        tools:el_expanded="true">

        <LinearLayout
            android:id="@+id/houseContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider_address_item"
            android:showDividers="middle"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="PLACEHOLDER FOR SLIDER PREVIEW"
                android:textSize="24sp"
                android:textAlignment="center"
                android:paddingVertical="16dp"
                android:background="#80FF00FF"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.sesameware.smartyard_oem.ui.main.FixedAspectRatioFrameLayout
                android:id="@+id/sliderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:aspectRatio="16:9"
                android:visibility="gone">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/entranceViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.rd.PageIndicatorView
                    android:id="@+id/pageIndicatorView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_gravity="top|center_horizontal"
                    app:piv_animationType="worm"
                    app:piv_selectedColor="@color/on_filled"
                    app:piv_unselectedColor="#66FFFFFF" />

            </com.sesameware.smartyard_oem.ui.main.FixedAspectRatioFrameLayout>

            <include
                android:id="@+id/yardDemoItem"
                layout="@layout/item_yard"
                android:visibility="gone"
                tools:visibility="visible" />

            <include
                android:id="@+id/camerasItem"
                layout="@layout/item_video_camera" />

            <include
                android:id="@+id/eventLogItem"
                layout="@layout/item_event_log" />

            <include
                android:id="@+id/webExtDemoItem"
                layout="@layout/item_web_ext"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
        
    </net.cachapa.expandablelayout.ExpandableLayout>

</LinearLayout>