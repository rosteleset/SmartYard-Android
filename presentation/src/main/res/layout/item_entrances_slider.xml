<?xml version="1.0" encoding="utf-8"?>
<com.sesameware.smartyard_oem.ui.main.FixedAspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:aspectRatio="16:9"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/entranceViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_height="250dp" />

    <com.rd.PageIndicatorView
        android:id="@+id/pageIndicatorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_gravity="top|center_horizontal"
        app:piv_animationType="worm"
        app:piv_selectedColor="@color/on_filled"
        app:piv_unselectedColor="#66FFFFFF" />

</com.sesameware.smartyard_oem.ui.main.FixedAspectRatioFrameLayout>
