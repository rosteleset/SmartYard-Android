<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/background_card"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAddressTitle"
            style="@style/Base.TextAppearance.AppCompat.Subhead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:padding="24dp"
            android:text="@string/domophone_notif_title"
            android:textColor="@color/untinted_vector"
            android:textSize="18sp"
            tools:text="г. Тамбов, ул. Советская, 16" />

        <ImageView
            android:id="@+id/ivExpandHouse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerInside"
            android:layout_gravity="center_vertical|end"
            app:srcCompat="@drawable/ic_expand"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <net.cachapa.expandablelayout.ExpandableLayout
        android:id="@+id/expandableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:el_duration="250"
        app:el_expanded="false"
        tools:el_expanded="true">

        <LinearLayout
            android:id="@+id/doorsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider_address_item"
            android:orientation="vertical"
            android:showDividers="middle" />

    </net.cachapa.expandablelayout.ExpandableLayout>

</LinearLayout>
