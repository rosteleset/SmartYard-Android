<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nsvVideoPlayback"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background"
    android:fillViewport="true"
    tools:context=".ui.main.address.cctv_video.detail.CCTVOnlineTabFragment">

    <LinearLayout
        android:id="@+id/llVideoPlayback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <com.sesameware.smartyard_oem.ui.main.FixedAspectRatioFrameLayout
            android:id="@+id/videoWrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp"
            app:aspectRatio="16:9"
            android:background="@drawable/background_radius_video_clip">

            <com.sesameware.smartyard_oem.ui.common.player.CCTVPlayerView
                android:id="@+id/cctvPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.sesameware.smartyard_oem.ui.main.IconCardButton
                android:id="@+id/mFullScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:src="@drawable/selector_fullscreen"
                android:visibility="visible" />

            <com.sesameware.smartyard_oem.ui.main.IconCardButton
                android:id="@+id/mMute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:src="@drawable/selector_mute"
                android:visibility="invisible"
                tools:visibility="visible" />

            <com.sesameware.smartyard_oem.ui.main.IconCardButton
                android:id="@+id/ivPlayerLog"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_gravity="bottom|center"
                android:layout_margin="8dp"
                android:src="@drawable/ic_log"
                android:visibility="gone"
                tools:visibility="visible" />

        </com.sesameware.smartyard_oem.ui.main.FixedAspectRatioFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="18dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
