<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.settings.basicSettings.BasicSettingsFragment">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/background_top_narrow"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />


    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/title_common_settings"
        android:textColor="@color/on_filled"
        android:textSize="32sp"
        android:textStyle="bold"
        app:autoSizeMinTextSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBack" />


    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="28dp"
        android:padding="16dp"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/background_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <View
        android:id="@+id/user_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/background_card"
        app:layout_constraintTop_toTopOf="@+id/background"
        app:layout_constraintBottom_toBottomOf="@id/tvUserPhone"/>

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="false"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:textColor="@color/accent"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/user_card"
        app:layout_constraintTop_toTopOf="@id/user_card"
        tools:text="@string/user_name_sample" />

    <TextView
        android:id="@+id/tvUserPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="false"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp"
        android:textColor="@color/no_accent"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/user_card"
        app:layout_constraintTop_toBottomOf="@id/tvUserName"
        tools:text="@string/user_phone_sample" />

    <ImageView
        android:id="@+id/ivNameEdit"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@id/tvUserPhone"
        app:layout_constraintEnd_toEndOf="@id/user_card"
        app:layout_constraintTop_toTopOf="@+id/tvUserName"
        app:srcCompat="@drawable/ic_pencil_edit"
        tools:ignore="ContentDescription" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserPhone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/background_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title_domophone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:text="@string/title_notifications"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    app:drawableEndCompat="@drawable/ic_arrow_bottom" />


                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/expandableLayoutNotif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_duration="300"
                    app:el_expanded="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/view3"
                            android:layout_width="match_parent"
                            android:layout_height="0.7dp"
                            android:background="@color/dialog_background"
                            android:paddingEnd="18dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvShowNotify"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="24dp"
                            android:text="@string/receive_notifications"
                            android:textColor="@color/accent"
                            app:layout_constraintEnd_toStartOf="@+id/swShowNotify"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/view3" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swShowNotify"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:button="@drawable/switch_button_selector"
                            android:paddingStart="24dp"

                            android:thumb="@null"
                            app:layout_constraintBottom_toBottomOf="@+id/tvShowNotify"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:track="@null" />

                        <View
                            android:id="@+id/pdShowNotify"
                            android:layout_width="match_parent"
                            android:layout_height="0.7dp"
                            android:background="@color/dialog_background"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.615"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvShowNotify" />

                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/gSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="soundTitle, tvSoundChoose, pdSound" />

                        <TextView
                            android:id="@+id/soundTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="24dp"
                            android:text="@string/sound"
                            android:textColor="@color/accent"
                            app:layout_constraintEnd_toStartOf="@+id/tvSoundChoose"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/pdShowNotify" />

                        <TextView
                            android:id="@+id/tvSoundChoose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="24dp"
                            android:textColor="@color/brand"
                            app:layout_constraintBottom_toBottomOf="@+id/soundTitle"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/pdShowNotify"
                            tools:text="Def" />

                        <View
                            android:id="@+id/pdSound"
                            android:layout_width="match_parent"
                            android:layout_height="0.7dp"
                            android:background="@color/dialog_background"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.307"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/soundTitle" />

                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/gCallRingtone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="ivCallRingtone, tvCallRingtone, pdCallRingtone" />

                        <TextView
                            android:id="@+id/tvCallRingtone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="false"
                            android:gravity="center_vertical"
                            android:paddingStart="24dp"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:text="@string/title_call_ringtone"
                            android:textColor="@color/accent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/pdSound" />

                        <ImageView
                            android:id="@+id/ivCallRingtone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="24dp"
                            android:clickable="false"
                            android:longClickable="false"
                            app:layout_constraintBottom_toBottomOf="@+id/tvCallRingtone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/pdSound"
                            app:srcCompat="@drawable/ic_arrow_right" />

                        <View
                            android:id="@+id/pdCallRingtone"
                            android:layout_width="match_parent"
                            android:layout_height="0.7dp"
                            android:background="@color/dialog_background"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.307"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvCallRingtone" />

                        <TextView
                            android:id="@+id/tvBalanceCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="fill_vertical"
                            android:paddingLeft="24dp"
                            android:paddingTop="24dp"
                            android:text="@string/lack_funds_notifications"
                            android:textColor="@color/accent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/pdCallRingtone" />

                        <TextView
                            android:id="@+id/tvBalanceTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="fill_vertical"
                            android:paddingLeft="24dp"
                            android:paddingBottom="16dp"
                            android:text="@string/balance_notify_near_zero"
                            android:textColor="@color/no_accent"
                            app:layout_constraintEnd_toStartOf="@+id/sBalance"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvBalanceCaption" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:button="@drawable/switch_button_selector"
                            android:paddingEnd="24dp"
                            android:thumb="@null"
                            app:layout_constraintBottom_toBottomOf="@+id/tvBalanceTitle"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tvBalanceCaption"
                            app:track="@null" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </net.cachapa.expandablelayout.ExpandableLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCameras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/background_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitleCameras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:text="@string/title_cameras"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    app:drawableEndCompat="@drawable/ic_arrow_bottom" />

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/expandableLayoutCameras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_duration="300"
                    app:el_expanded="false">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/vLineShowOnMap"
                            android:layout_width="match_parent"
                            android:layout_height="0.7dp"
                            android:background="@color/dialog_background"
                            android:paddingEnd="18dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvShowOnMap"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="24dp"
                            android:text="@string/show_on_map"
                            android:textColor="@color/accent"
                            app:layout_constraintEnd_toStartOf="@+id/swShowOnMap"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/vLineShowOnMap" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swShowOnMap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:button="@drawable/switch_button_selector"
                            android:paddingStart="24dp"

                            android:thumb="@null"
                            app:layout_constraintBottom_toBottomOf="@+id/tvShowOnMap"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:track="@null" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </net.cachapa.expandablelayout.ExpandableLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvTitleSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:text="@string/title_security"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    app:drawableEndCompat="@drawable/ic_arrow_bottom" />

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/expandableLayoutSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_duration="300"
                    app:el_expanded="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTitleSecurity">

                        <TextView
                            android:id="@+id/textView25"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="24dp"
                            android:paddingTop="24dp"
                            android:text="@string/fingerprint_entrance"
                            android:textColor="@color/accent"
                            app:layout_constraintEnd_toStartOf="@+id/switch3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:button="@drawable/switch_button_selector"
                            android:paddingStart="24dp"
                            android:thumb="@null"
                            app:layout_constraintBottom_toBottomOf="@+id/textView26"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/textView25"
                            app:track="@null" />

                        <TextView
                            android:id="@+id/textView26"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="24dp"
                            android:paddingBottom="24dp"
                            android:text="@string/fingerprint_entrance_description"
                            android:textColor="@color/no_accent"
                            app:layout_constraintEnd_toStartOf="@+id/switch3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView25" />

                        <View
                            android:id="@+id/view7"
                            android:layout_width="match_parent"
                            android:layout_height="0.7dp"
                            android:background="@color/dialog_background"
                            android:paddingEnd="18dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="1.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView26" />

                        <TextView
                            android:id="@+id/textView27"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="24dp"
                            android:paddingTop="24dp"
                            android:text="@string/pin_code_entrance"
                            android:textColor="@color/accent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/view7" />

                        <TextView
                            android:id="@+id/textView28"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="24dp"
                            android:paddingBottom="16dp"
                            android:text="@string/pin_code_entrance_description"
                            android:textColor="@color/no_accent"
                            app:layout_constraintEnd_toStartOf="@+id/switch4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView27" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:button="@drawable/switch_button_selector"
                            android:paddingStart="24dp"
                            android:thumb="@null"
                            app:layout_constraintBottom_toBottomOf="@+id/textView28"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/textView27"
                            app:track="@null" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </net.cachapa.expandablelayout.ExpandableLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvTitleTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/background_card"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="26dp"
                android:paddingBottom="24dp"
                android:text="@string/title_theme"
                android:textColor="@color/accent"
                android:textSize="18sp"
                app:drawableEndCompat="@drawable/ic_arrow_right" />

            <TextView
                android:id="@+id/cvExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/background_card"
                android:gravity="center_vertical"
                android:padding="24dp"
                android:text="@string/text_logout"
                android:textColor="@color/negative"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvAppInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="48dp"
                android:textAlignment="center"
                android:textColor="@color/no_accent"
                android:textSize="14sp"
                tools:text="TextView" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>