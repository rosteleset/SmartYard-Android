<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="item_incoming_call_button_attributes">
        <attr name="buttonBG" format="reference" />
        <attr name="buttonCheckable" format="boolean" />
        <attr name="android:text" format="reference" />
        <attr name="orientationLandscap" format="boolean" />
    </declare-styleable>

    <declare-styleable name="MorphBottomNavigationView">
        <attr format="color" name="backgroundTint"/>
        <attr format="dimension" name="morphItemRadius"/>
        <attr format="dimension" name="morphVerticalOffset"/>
        <attr format="dimension" name="morphCornerRadius"/>
    </declare-styleable>

    <declare-styleable name="FixedListView">
        <attr name="tools_listItem" format="reference" />
        <attr name="tools_itemCount" format="integer" />
    </declare-styleable>

    <declare-styleable name="FixedAspectRatioFrameLayout">
        <attr name="aspectRatio" format="string" />
        <attr name="dominantDimension" format="enum">
            <enum name="width" value="0" />
            <enum name="height" value="1" />
            <enum name="auto" value="2" />
        </attr>
    </declare-styleable>

</resources>
